{
  "name": "calcmot-site",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  "routes": [
    { "pattern": "calcmot.com.br", "custom_domain": true },
    { "pattern": "www.calcmot.com.br", "custom_domain": true },
  ],
  "assets": {
    "directory": "dist/calcmot-cloudflare/browser",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/admin", "/admin/*", "/api", "/api/*", "/index.csr*"],
  },
  "observability": { "enabled": true },
  "ratelimits": [
    { "name": "RIDE_AI_LIMITER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
  ],
  "build": { "command": "npm run build:cloudflare" },
}
